# Copy to .env and fill in. .env is gitignored; this example is not.
# Required: TELEGRAM_BOT_TOKEN, TELEGRAM_OWNER_ID, and OPENAI_API_KEY
# (unless you run a local model).

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your numeric Telegram user id (message.from.id from getUpdates).
# The shell, file-write and memory tools are locked to it.
TELEGRAM_OWNER_ID=123456789
# Optional: proxy and slow-network settings.
#   LUMI__BOT__PROXY_URL=socks5://127.0.0.1:9050
#   LUMI__BOT__CONNECT_TIMEOUT=15
#   LUMI__BOT__BOOTSTRAP_RETRIES=3

# --- LLM ---
# The key. Comma-separate for a pool; llm.key_strategy picks
# fallback | round_robin | random.
#   OPENAI_API_KEY=sk-...90, sk-...91
#   OPENAI_API_KEY=sk-...90; sk-...91
OPENAI_API_KEY=sk-...
# Unset = api.openai.com. A base_url in config.toml or LUMI__LLM__BASE_URL wins.
#   OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama
#   OPENAI_BASE_URL=http://localhost:1234/v1      # LM Studio / vLLM
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=nemotron-3-nano-reasoning
# Check what actually resolved:
#   lumi config --key llm.base_url    lumi config --key llm.model

# --- Model routing: which model reads what ---
# One default for everything — text, photos and PDFs:
#   LUMI__LLM__MODEL=gpt-4.1-mini
# (Unset = OPENAI_MODEL, then the built-in default.)
# Images — photos in chat, image files the ocr tool reads — go to the vision
# model when one is set, otherwise to LUMI__LLM__MODEL:
#   LUMI__LLM__VISION_MODEL=gpt-4o
#   OPENAI_VISION_MODEL=gpt-4o          # same setting, OpenAI-style alias
# PDFs — scanned pages the ocr tool reads — go to the ocr model when one is
# set, otherwise to LUMI__LLM__MODEL (never to the vision model):
#   LUMI__LLM__OCR_MODEL=gpt-4o-mini
# Check what resolved:
#   lumi config --key llm.vision_model    lumi config --key llm.ocr_model
# A whole route (own provider / endpoint / key) per role, if you need one:
#   LUMI__LLM__VISION__PROVIDER=openrouter
#   LUMI__LLM__VISION__BASE_URL=https://openrouter.ai/api/v1
#   LUMI__LLM__VISION__API_KEY_ENV=OPENROUTER_API_KEY
#   LUMI__LLM__VISION__KEY_STRATEGY=fallback
#   LUMI__LLM__OCR__PROVIDER=openai-compatible
#   LUMI__LLM__OCR__BASE_URL=http://localhost:8000/v1
#   LUMI__LLM__OCR__API_KEY_ENV=LOCAL_LLM_API_KEY
#   LUMI__LLM__OCR__KEY_STRATEGY=fallback
# Unset fields inherit [llm]; provider names do not choose a base URL.
# VISION__MODEL / OCR__MODEL override the corresponding flat model settings.
# The llm OCR model must accept image inputs through chat completions.
# Retries cover connection errors, timeouts, 408/409/429, 5xx, and empty
# reasoning-only answers. Defaults: 4 extra attempts, backoff 0.5, 1, 2, 4s.
#   LUMI__LLM__INFERENCE_RETRIES=4              # 0 disables the retry loop
#   LUMI__LLM__INFERENCE_RETRY_DELAY=0.5
# Reasoning models (gpt-oss, DeepSeek reasoner, Qwen3, o-series, gpt-5, ...):
#   LUMI__LLM__REASONING=true                   # drops temperature
#   LUMI__LLM__REASONING_EFFORT=medium          # none|minimal|low|medium|high|xhigh|max
#   LUMI__LLM__REASONING_TOKENS=2000            # headroom for the thinking
#   LUMI__LLM__SHOW_REASONING=false             # keep thinking out of the chat
# Nothing is capped by default; set these only if your provider needs it:
#   LUMI__LLM__MAX_TOKENS=32000
#   LUMI__LLM__CONTEXT_WINDOW=200000

# --- Dedicated OCR API (optional) ---
# Whole documents (PDFs, scans) to a Mistral-style POST /ocr endpoint:
# per-page markdown back, no per-page model tokens. Leave PROVIDER unset and
# the local path is used instead — embedded text extracted free, scanned
# pages read by LUMI__LLM__OCR_MODEL, else LUMI__LLM__MODEL.
#   LUMI__TOOLS__OCR__PROVIDER=mistral      # or "custom" for your own host
#   LUMI__TOOLS__OCR__MODEL=mistral-ocr-latest   # an OCR model id ("what to set")
#   LUMI__TOOLS__OCR__BASE_URL=https://api.mistral.ai/v1  # required for "custom"
#   LUMI__TOOLS__OCR__API_KEY_ENV=MISTRAL_API_KEY   # name of the var holding the key
#   MISTRAL_API_KEY=mk-...                   # the key itself
# Image files still use the vision/default route, not this document API.
# A missing dedicated API key makes the tool unavailable; no automatic fallback.
# Local-path knobs (no provider):
#   LUMI__TOOLS__OCR__MAX_PAGES=20           # pages per call, 0 = all
#   LUMI__TOOLS__OCR__RENDER_SCALE=3.0       # scan render scale (1.0 = 72 DPI)

# --- Web search (optional) ---
# Tavily works keyless (free tier); comma-separate keys to rotate.
#   TAVILY_API_KEY=tvly-...90, tvly-...91
TAVILY_API_KEY=tvly-...
# Firecrawl has no keyless tier; same rotation rules.
#   FIRECRAWL_API_KEY=fc-...90, fc-...91
FIRECRAWL_API_KEY=fc-...

# Remote MCP servers read these from here when expanding .mcp.json.
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}
# FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/${FIRECRAWL_API_KEY}/v2/mcp

# --- Library docs (optional) ---
# Unlocks the context7 tool; comma-separate for a key pool.
#   CONTEXT7_API_KEY=ctx7sk-...91, ctx7sk-...92
CONTEXT7_API_KEY=ctx7sk-...
