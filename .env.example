# Copy to .env and fill in. .env is gitignored; this example is not.
# Every value here is optional except TELEGRAM_BOT_TOKEN and TELEGRAM_OWNER_ID
# (and OPENAI_API_KEY, unless you run a local model).

# --- Telegram (required) -----------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your numeric Telegram user id. Send /start to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.from.id.
# The shell, file-write and memory tools are locked to this id and no other.
TELEGRAM_OWNER_ID=123456789
# If api.telegram.org is slow or blocked from your network, point the bot at a
# SOCKS5 or HTTP proxy (same as bot.proxy_url in config.toml):
#   LUMI__BOT__PROXY_URL=socks5://127.0.0.1:9050
# A slow network can also need a longer TCP connect timeout than PTB's 5s
# default and a retry when startup hits a hiccup:
#   LUMI__BOT__CONNECT_TIMEOUT=15
#   LUMI__BOT__BOOTSTRAP_RETRIES=3

# --- LLM (required unless you run a local model) -----------------------------
# The key. For a non-OpenAI provider, either put its key here or point
# llm.api_key_env in config.toml at its own variable name (GROQ_API_KEY, ...).
# Comma-separate to keep a pool: a key that hits a rate limit or runs out of
# quota is skipped, and the next one answers instead. Semicolons and newlines
# work too, so a long list can be written one per line.
# llm.key_strategy picks how they are spent: fallback (first key, move on only
# when it fails), round_robin (one each in turn) or random.
#   OPENAI_API_KEY=sk-...90, sk-...91
#   OPENAI_API_KEY=sk-...90; sk-...91
OPENAI_API_KEY=sk-...
# The endpoint. Unset means api.openai.com. Read as a fallback: an explicit
# base_url in config.toml, or LUMI__LLM__BASE_URL, takes precedence over it.
# Aliases also accepted: OPENAI_API_BASE, OPENAI_API_BASE_URL.
#   OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama
#   OPENAI_BASE_URL=http://localhost:1234/v1      # LM Studio / vLLM
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
# The model id, same fallback rules. LUMI__LLM__MODEL takes precedence.
# OPENAI_MODEL=nemotron-3-nano-reasoning
# Check what actually resolved, any time:
#   lumi config --key llm.base_url    lumi config --key llm.model
#
# Reasoning models (gpt-oss, DeepSeek reasoner, Qwen3, o-series, gpt-5, ...)
# need three things that are fiddly to get right by hand. Set these instead:
#   LUMI__LLM__REASONING=true           # drops temperature, uses max_completion_tokens
#   LUMI__LLM__REASONING_EFFORT=medium  # none|minimal|low|medium|high|xhigh|max
#   LUMI__LLM__REASONING_TOKENS=2000    # headroom for the thinking, on top of max_tokens
# LUMI__LLM__SHOW_REASONING=false       # keep thinking traces out of the chat
# Unset effort sends "medium" while REASONING=true — the value doubles as the
# thinking on/off switch on endpoints like Ollama's, so a default-off model
# (gemma4, ...) only thinks when a value is sent. "none" disables thinking.
# See the reasoning section of config.toml for what each one does.

# --- Web search (optional, Tavily also accepts keyless) ----------------------
# Tavily: leave TAVILY_API_KEY unset to use the free tier (lower rate limit;
# search and extract only). With one or more keys, a failed key is parked for
# a minute and the next one answers — same shape as OPENAI_API_KEY.
#   TAVILY_API_KEY=tvly-...90, tvly-...91
# tools.web.tavily.key_strategy picks how a pool is spent: fallback (default),
# round_robin, or random.
TAVILY_API_KEY=tvly-...

# Firecrawl: no keyless tier, but the same rotation rules apply. A comma-
# separated pool keeps the bot up when one key hits a rate limit or dies.
#   FIRECRAWL_API_KEY=fc-...90, fc-...91
FIRECRAWL_API_KEY=fc-...

# Remote MCP servers read these from here when expanding .mcp.json.
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}
# FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/${FIRECRAWL_API_KEY}/v2/mcp

# --- Library docs (optional) -------------------------------------------------
# CONTEXT7_API_KEY unlocks the `context7` tool: up-to-date library docs and
# code examples from https://context7.com. Leave unset to keep the tool hidden
# from the model. Get a key at https://context7.com/dashboard — keys start
# with "ctx7sk".
#
# Comma-separate to make a rotation pool — same shape as OPENAI_API_KEY.
# tools.context7.key_strategy picks how they are spent:
#   fallback (default) | round_robin | random
#   CONTEXT7_API_KEY=ctx7sk-...91, ctx7sk-...92
CONTEXT7_API_KEY=ctx7sk-...
