# Copy to .env and fill in. .env is gitignored; this example is not.
# Required: TELEGRAM_BOT_TOKEN, TELEGRAM_OWNER_ID, and OPENAI_API_KEY
# (unless you run a local model).

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your numeric Telegram user id (message.from.id from getUpdates).
# The shell, file-write and memory tools are locked to it.
TELEGRAM_OWNER_ID=123456789
# Optional: proxy and slow-network settings.
#   LUMI__BOT__PROXY_URL=socks5://127.0.0.1:9050
#   LUMI__BOT__CONNECT_TIMEOUT=15
#   LUMI__BOT__BOOTSTRAP_RETRIES=3

# --- LLM ---
# The key. Comma-separate for a pool; llm.key_strategy picks
# fallback | round_robin | random.
#   OPENAI_API_KEY=sk-...90, sk-...91
#   OPENAI_API_KEY=sk-...90; sk-...91
OPENAI_API_KEY=sk-...
# Unset = api.openai.com. A base_url in config.toml or LUMI__LLM__BASE_URL wins.
#   OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama
#   OPENAI_BASE_URL=http://localhost:1234/v1      # LM Studio / vLLM
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=nemotron-3-nano-reasoning
# Check what actually resolved:
#   lumi config --key llm.base_url    lumi config --key llm.model
# Retries cover connection errors, timeouts, 408/409/429, 5xx, and empty
# reasoning-only answers. Defaults: 4 extra attempts, backoff 0.5, 1, 2, 4s.
#   LUMI__LLM__INFERENCE_RETRIES=4              # 0 disables the retry loop
#   LUMI__LLM__INFERENCE_RETRY_DELAY=0.5
# Reasoning models (gpt-oss, DeepSeek reasoner, Qwen3, o-series, gpt-5, ...):
#   LUMI__LLM__REASONING=true                   # drops temperature
#   LUMI__LLM__REASONING_EFFORT=medium          # none|minimal|low|medium|high|xhigh|max
#   LUMI__LLM__REASONING_TOKENS=2000            # headroom for the thinking
#   LUMI__LLM__SHOW_REASONING=false             # keep thinking out of the chat
# Nothing is capped by default; set these only if your provider needs it:
#   LUMI__LLM__MAX_TOKENS=32000
#   LUMI__LLM__CONTEXT_WINDOW=200000

# --- Web search (optional) ---
# Tavily works keyless (free tier); comma-separate keys to rotate.
#   TAVILY_API_KEY=tvly-...90, tvly-...91
TAVILY_API_KEY=tvly-...
# Firecrawl has no keyless tier; same rotation rules.
#   FIRECRAWL_API_KEY=fc-...90, fc-...91
FIRECRAWL_API_KEY=fc-...

# Remote MCP servers read these from here when expanding .mcp.json.
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}
# FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/${FIRECRAWL_API_KEY}/v2/mcp

# --- Library docs (optional) ---
# Unlocks the context7 tool; comma-separate for a key pool.
#   CONTEXT7_API_KEY=ctx7sk-...91, ctx7sk-...92
CONTEXT7_API_KEY=ctx7sk-...
